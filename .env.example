# HTTP nastavení
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_CONCURRENCY=5
HTTP_REQUESTS_PER_SECOND=2
HTTP_MAX_RESPONSE_BYTES=50000000
HTTP_RETRY_MIN_WAIT_SECONDS=0.5
HTTP_RETRY_MAX_WAIT_SECONDS=5
HTTP_USER_AGENT=fundscraper/0.1

# Browser scraping
PLAYWRIGHT_ENABLED=false

# Vyhledávání chybějících domén (scripts/find_missing_domains.py).
# Bez těchto klíčů se použijí bezklíčové HTML vyhledávače, které ale
# často vracejí ochrannou stránku místo výsledků.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Aplikační prostředí
LOG_LEVEL=INFO