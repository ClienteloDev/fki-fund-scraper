# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/

# Testing and code quality
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# Runtime cache
cache/*
!cache/.gitkeep

# SQLite runtime files
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm

# Generated output
data/output/*
!data/output/.gitkeep

# Logs
*.log

# IDE and operating system
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
~$*

# Runtime pipeline reports
reports/*.json

# BEGIN fundscraper runtime artifacts

# Runtime databases and caches
/cache/

# Backups and local releases
/backups/
/releases/

# Generated reports
/reports/

# Generated enriched outputs
/data/output/*
!/data/output/.gitkeep

# Local database checkpoints. Generated data, excluded for the same reason as
# /data/output and /reports. Git therefore does NOT protect the fund database
# copies kept under artifacts/checkpoints/ - see the README in each checkpoint.
/artifacts/

# Generated retry, sample and partial inputs
/data/input/funds.retry*.json
/data/input/*retry*.json
/data/input/*partial*.json
/data/input/*sample*.json

# Downloaded patch packages and extracted installers
/tools/*-patch/
/tools/*-launcher/
*.zip

# Temporary and backup files
*.bak
*.tmp

# One-off audit and partial-run scripts
/scripts/build-retry-input.ps1
/scripts/inspect-partial-run.ps1
/scripts/audit-sample.ps1
/scripts/*partial*.ps1
/scripts/*audit*.ps1
/scripts/*sample*.ps1

# END fundscraper runtime artifacts
